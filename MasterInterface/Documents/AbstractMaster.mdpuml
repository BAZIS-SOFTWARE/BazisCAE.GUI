@startuml

abstract class AbstractMaster
interface IMasterInterface
{
	inpStr ExecCmd("outStr - "cmd" "arg1" "arg2"..)
	inpStr - "state" "cmd" "res")
}

interface IMaterialsHandling
{
event EventHandler<EventArgs> OnMaterialsRequested
void SetMaterials(IEnumerable<string> materials)
}
interface IFunctionsHandling
{
event EventHandler<EventArgs> OnFunctionsRequested
void SetFunctions(IEnumerable<string> functions)
}
interface IGroupHandling
{
        event EventHandler<EventArgs> OnGroupsRequested   
        void AddGroup(GroupType type, int number, string groupName)
        void RenameGroup(GroupType type, int number, string newName)
        void DeleteGroup(GroupType type, int number)
        void DeleteAllGroups();
        void InitialGroupFilling(Dictionary<GroupType, Dictionary<int, string>> groups)
        }
interface IPreparedDataLoader

IMasterInterface <|.. AbstractMaster

@enduml