@startuml

class PrintInfoEventArgs {
  + Message : string
  + Color : Color
  + PrintInfoEventArgs(string message, Color color)
}

class GenerateConditionsEventArgs {
  + Conditions : string[]
  + GenerateConditionsEventArgs(string[] conditions)
}

class UpdateSceneEventArgs {
  + UpdateSceneEventArgs()
}

interface IBaseMaster {
}

class UserControl {
}

class BaseMaster {
  - executeCommand : Func<string, Task<string>>?
  + {event} PrintInfoEvent : EventHandler<PrintInfoEventArgs>
  + {event} GenerateConditionsEvent : EventHandler<GenerateConditionsEventArgs>
  + {event} UpdateSceneEvent : EventHandler<UpdateSceneEventArgs>
  + {event} OnMasterLoaded : EventHandler<EventArgs>
  + {abstract} MasterName : string
  + BaseMaster()
  # RaiseGenerateConditionsEvent(string[] strings) : void
  # RaisePrintInfoEvent(string str, Color color) : void
  # RaiseUpdateSceneEvent() : void
  + ExecuteCommand : Func<string, Task<string>>? { get; set; }
  + SetExecuteCommand(Func<string, Task<string>> command) : void
}

note "Делегат для выполнения команд асинхронно.\nПринимает строковую команду и возвращает\nрезультат выполнения в виде строки.\nМожет быть использован для выполнения\nSQL-запросов, вызова внешних API или\nобработки данных." as N1
note "Виртуальное свойство,\nвозвращает 'BaseMaster'" as N2
note "Устанавливает делегат для выполнения команд.\nВыбрасывает ArgumentNullException если command == null" as N3

N1 .. executeCommand
N2 .. MasterName
N3 .. SetExecuteCommand

BaseMaster --|> UserControl
BaseMaster ..|> IBaseMaster
BaseMaster ..> PrintInfoEventArgs : использует
BaseMaster ..> GenerateConditionsEventArgs : использует
BaseMaster ..> UpdateSceneEventArgs : использует
BaseMaster ..> Func : использует

@enduml