<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>
  <Style Selector="Button.tab:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>
  <Style Selector="Button.tab:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>

  <Style Selector="Button.action">
    <Setter Property="Width" Value="93" />
    <Setter Property="Height" Value="31" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="BorderBrush" Value="#B8B8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action:pointerover">
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>
  <Style Selector="Button.action:pressed">
    <Setter Property="Background" Value="#D5D5D5" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>

  <Style Selector="Button.closeButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#777777" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.closeButton:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#777777" />
  </Style>

  <Style Selector="TextBox.chamferInput">
    <Setter Property="Width" Value="221" />
    <Setter Property="Height" Value="27" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#969696" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>
</Styles>
