<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Кнопки действий (Захват, Сброс) -->
  <Style Selector="Button.action">
    <Setter Property="Height" Value="31" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="BorderBrush" Value="#B8B8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action:pointerover">
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>
  <Style Selector="Button.action:pressed">
    <Setter Property="Background" Value="#D5D5D5" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>

  <!-- Кнопка закрытия окна -->
  <Style Selector="Button.closeButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#777777" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.closeButton:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#777777" />
  </Style>

  <!-- Пресеты плоскости (в виде плоских кнопок, как в WinForms) -->
  <Style Selector="RadioButton.clipPresetButton">
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="BorderBrush" Value="#B8B8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="RadioButton.clipPresetButton:checked">
    <Setter Property="Background" Value="#D5D5D5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Обычные радиокнопки (режимы отображения) -->
  <Style Selector="RadioButton.clipRadio">
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Подписи компонент нормали (A: / B: / C:) -->
  <Style Selector="TextBlock.axisLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- Подписи полей -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Слайдеры компонент нормали -->
  <Style Selector="Slider.clipSlider">
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Поля D и толщины (только чтение, изменение перетаскиванием) -->
  <Style Selector="TextBox.clipInput">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#969696" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Комбобокс шага «Дельта D» -->
  <Style Selector="ComboBox.clipCombo">
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#969696" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
</Styles>
