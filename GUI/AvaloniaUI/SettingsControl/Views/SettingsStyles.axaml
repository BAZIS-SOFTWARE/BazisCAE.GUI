<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Кнопки действий (выбор цвета, обзор) -->
  <Style Selector="Button.action">
    <Setter Property="Height" Value="31" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="BorderBrush" Value="#B8B8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action:pointerover">
    <Setter Property="Background" Value="#E3E3E3" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>
  <Style Selector="Button.action:pressed">
    <Setter Property="Background" Value="#D5D5D5" />
    <Setter Property="Foreground" Value="#171717" />
  </Style>

  <!-- Кнопка закрытия окна -->
  <Style Selector="Button.closeButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#777777" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.closeButton:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#777777" />
  </Style>

  <!-- Подписи полей -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Значения слайдеров -->
  <Style Selector="TextBlock.valueLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- Чекбоксы настроек -->
  <Style Selector="CheckBox.fieldCheck">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#171717" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Слайдеры интенсивности и прозрачности -->
  <Style Selector="Slider.settingsSlider">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
