@startuml
package "Core" {
[proj controller]
[preProc]
[postProc]
[project]
[model]
[Geometry]
[GMSH Api]
}

package "BaseForm" {
[IOController]
[settingsConfig]
[VBOController]
[property provider]
[baseForm]
}

package "BaseModule" {
[baseForm] --> [console]
[baseForm] --> [navigator]
[baseForm] --> [property panel]

}
[baseForm] --> [ClientController]
[baseForm] --> [OpenGL Api]

[property provider] --> [proj controller]
[baseForm] --> [postProc]
[baseForm] --> [preProc]
[baseForm] --> [proj controller]
[proj controller] --> [project]
[proj controller] --> [preProc]
[proj controller] --> [GMSH Api]
[preProc] --> [project]
[postProc] --> [project]
[project] --> [model]
[project] --> [Geometry]
[model] --> [Geometry]
@enduml