@startuml
package "Core" {
[model controller]
[preProc]
[postProc]
[project]
[model]
[Geometry]
[GMSH Api]
}

package "BaseForm" {
[main menu]
[toolStrips]
[baseForm]
[property provider]
}

package "BaseModule" {
[baseForm] --> [console]
[baseForm] --> [navigator]
[baseForm] --> [property panel]

}

[baseForm] --> [OpenGL Api]

[property provider] --> [project]
[baseForm] --> [preProc]
[baseForm] --> [postProc]
[baseForm] --> [model controller]
[baseForm] --> [project]
[model controller] --> [model]
[model controller] --> [GMSH Api]
[preProc] --> [project]
[postProc] --> [project]
[project] --> [model]
[project] --> [Geometry]
[model] --> [Geometry]
@enduml