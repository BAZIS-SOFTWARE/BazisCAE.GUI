  }
  component "CmdInterpretator"
[PropertiesCalculator.dll]
[ClientController.dll]
[VboController]
} 

package "Master" {
IBaseMaster - [MasterInterface]
[AbstractMaster] --> IBaseMaster
}
[baseForm] --> [MasterInterface]

[CmdInterpretator] --> [proj controller]
[CmdInterpretator] --> [preProc]

[baseForm] --> [postProc]
[baseForm] --> [preProc]
[baseForm] --> [proj controller]
[baseForm] --> [Geometry]
[proj controller] --> [project]

[proj controller] --> [GMSH Api]
[preProc] --> [project]
[postProc] --> [model]
[postProc] --> [Results DB]
[Results DB] --> [SQLite]
[project] --> [model]
[project] --> [Material DB]
[PropertiesCalculator.dll] --> [Material DB]
[project] --> [Geometry]
[model] --> [Geometry]
