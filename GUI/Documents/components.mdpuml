@startuml
package "Core" {
[proj controller]
[preProc]
[postProc]
[project]
[model]
[Geometry]
[GMSH Api]
}

[baseForm] --> [ClientController]
[baseForm] --> [Tao.OpenGL Api]

[baseForm] --> [postProc]
[baseForm] --> [preProc]
[baseForm] --> [proj controller]
[proj controller] --> [project]
[proj controller] --> [preProc]
[proj controller] --> [GMSH Api]
[preProc] --> [project]
[postProc] --> [project]
[project] --> [model]
[project] --> [Geometry]
[model] --> [Geometry]
@enduml