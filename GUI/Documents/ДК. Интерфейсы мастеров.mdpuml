@startuml
interface IMaster{
event **Action<string, Color>** PrintInfoEvent
--
event **Action<string[]>** SubmitParametrizedStringsEvent
--
event **Action** UpdateSceneEvent;
--
string MasterName { **get;** }
--
**void** InitialMasterFilling(**IEnumerable<string>** materials, **IEnumerable<string>** functions, **Dictionary<int, string>** groups)
--
**void** AddGroup(**int** number, **string** groupName)
--
**void** RenameGroup(**int** number, **string** groupName)
--
**void** DeleteGroup(**int** number, **string** groupName)
--
**void** ChangeMaterials(**IEnumerable<string>** materials)
--
**void** ChangeFunctions(**IEnumerable<string>** functions)
}

abstract Master
Master <|.up.. IMaster

@enduml