@startuml
left to right direction
skinparam packageStyle rectangle
actor Проектировщик
actor Технолог

rectangle GUI {
  (визуализация результатов задач)
  (управление ИИ помощником)
  (визуализация схемы печи)
 
  (визуализация суррогатной модели)
}

rectangle Оптимизация {
  (построение суррогатной модели)
  (расчет оптимального режима печи)
}

rectangle Проектирование {
  (расчет схемы печи)
}

rectangle CAE {
  (расчет задачи газодинамики)
  (расчет задачи теплопроводности)
  
  (расчет схемы печи) .> (расчет задачи газодинамики)
  (расчет задачи газодинамики) .> (расчет задачи теплопроводности)
  (оценка горячих трещин)
}

note Left of (расчет схемы печи)
  Scene.dll
end note

note Left of (расчет задачи газодинамики)
  Решатель*
end note

note Left of (расчет задачи теплопроводности)
  Project.dll,
  PreProc.dll
end note

@enduml