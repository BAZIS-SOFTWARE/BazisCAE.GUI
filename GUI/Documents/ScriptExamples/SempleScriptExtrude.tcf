"Set mesh curve" "$line1" "4" "Progression" "1"
"Set mesh curve" "$line2" "4" "Progression" "1"
"Set mesh curve" "$line3" "4" "Progression" "1"

"Set regular mesh surface" "$surface1" "$p3,$p1,$p2" "Left" "quad"
