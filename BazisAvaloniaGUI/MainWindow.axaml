<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scene="using:BazisAvaloniaGUI"
        x:Class="BazisAvaloniaGUI.MainWindow"
        Title="BazisAvaloniaGUI — 3D сцена"
        Width="1100"
        Height="750">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="8">
            <Button x:Name="LoadButton" Content="Загрузить" HorizontalAlignment="Left" />
            <Button x:Name="InsideButton" Content="Скрыть внутренние поверхности" IsEnabled="False" />
            <ComboBox x:Name="ObjectSelector" Width="170" IsEnabled="False" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ВРЕМЕННО: бортик для контроля границ SceneView внутри окна.
             Удалить: заменить <Border>...</Border> обратно на <scene:SceneView Grid.Row="1" x:Name="scene" />
             (и убрать временный вывод размера в MainWindow.axaml.cs). -->
        <Border Grid.Row="1" BorderBrush="Red" BorderThickness="1">
            <scene:SceneView x:Name="scene" />
        </Border>
    </Grid>
</Window>
