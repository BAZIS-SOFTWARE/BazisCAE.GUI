<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The 16 px indicator is independent of its label, so text can follow system DPI. -->
  <Style Selector="CheckBox.database-toggle, RadioButton.database-toggle">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="BorderBrush" Value="#000000" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="CheckBox.database-toggle">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
          <Border Name="DatabaseIndicator" Width="16" Height="16" Padding="2,3"
                  VerticalAlignment="Center" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Path Name="DatabaseCheck" Data="M 0,4 L 3,7 L 9,0" Stretch="Uniform"
                  Stroke="#000000" StrokeThickness="1.5" IsVisible="False" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.database-toggle">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
          <Border Name="DatabaseIndicator" Width="16" Height="16" Padding="3" CornerRadius="8"
                  VerticalAlignment="Center" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Ellipse Name="DatabaseDot" Fill="#000000" IsVisible="False" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.database-toggle:checked /template/ Path#DatabaseCheck">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="RadioButton.database-toggle:checked /template/ Ellipse#DatabaseDot">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="CheckBox.database-toggle:pointerover, RadioButton.database-toggle:pointerover">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="CheckBox.database-toggle:pressed, RadioButton.database-toggle:pressed">
    <Setter Property="Background" Value="#E5E5E5" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="CheckBox.database-toggle:disabled, RadioButton.database-toggle:disabled">
    <Setter Property="Background" Value="#F8F8F8" />
    <Setter Property="BorderBrush" Value="#CACACA" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
