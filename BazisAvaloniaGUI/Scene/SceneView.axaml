<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scene="using:BazisAvaloniaGUI"
             x:Class="BazisAvaloniaGUI.SceneView">

    <UserControl.Resources>
		<ControlTheme x:Key="SceneToggleButtonTheme" TargetType="ToggleButton">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Border"
							Background="{TemplateBinding Background}"
							CornerRadius="4">
						<ContentPresenter Name="PART_ContentPresenter"
										  Content="{TemplateBinding Content}"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>

			<!-- Базовый цвет (не нажат) -->
			<Setter Property="Background" Value="LightGray"/>
			<Setter Property="Foreground" Value="Black"/>

			<!-- Наведение -->
			<Style Selector="^:pointerover">
				<Setter Property="Background" Value="LightGray"/>
			</Style>

			<!-- Нажата в момент клика -->
			<Style Selector="^:pressed">
				<Setter Property="Background" Value="LightGray"/>
			</Style>

			<!-- Включена (checked) -->
			<Style Selector="^:checked">
				<Setter Property="Background" Value="LightGray"/>
				<Setter Property="Foreground" Value="Black"/>
			</Style>

			<!-- Включена + наведение -->
			<Style Selector="^:checked:pointerover">
				<Setter Property="Background" Value="LightGray"/>
			</Style>
		</ControlTheme>
        <Bitmap x:Key="XY">avares://BazisAvaloniaGUI/Scene/Assets/xy.png</Bitmap>
        <Bitmap x:Key="ZX">avares://BazisAvaloniaGUI/Scene/Assets/zx.png</Bitmap>
        <Bitmap x:Key="ZY">avares://BazisAvaloniaGUI/Scene/Assets/zy.png</Bitmap>
        <Bitmap x:Key="rotX">avares://BazisAvaloniaGUI/Scene/Assets/rotX.png</Bitmap>
        <Bitmap x:Key="rotY">avares://BazisAvaloniaGUI/Scene/Assets/rotY.png</Bitmap>
        <Bitmap x:Key="rotZ">avares://BazisAvaloniaGUI/Scene/Assets/rotZ.png</Bitmap>
        <Bitmap x:Key="rotHor">avares://BazisAvaloniaGUI/Scene/Assets/rotHor90.png</Bitmap>
        <Bitmap x:Key="rotVer">avares://BazisAvaloniaGUI/Scene/Assets/rotVer90.png</Bitmap>
	</UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Path#ExpandArrow">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions> 
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton:checked Path#ExpandArrow">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>

        <!-- Кнопка с чёрной обводкой: рамка всегда толщиной 1, меняется только цвет (Transparent ↔ Black),
             чтобы содержимое не смещалось на пиксель при переключении. -->
        <Style Selector="ToggleButton.OutlineButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.OutlineButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="Black" />
        </Style>
        <!-- У включённой кнопки фон оставляем тем же: Fluent по умолчанию красит его в акцентный. -->
        <Style Selector="ToggleButton.OutlineButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="WhiteSmoke" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <scene:SceneSurface x:Name="surface" Focusable="True" />
        <StackPanel Margin="10" Spacing="4"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top">
            <ToggleButton x:Name="OverlayToggle" 
                         Theme="{StaticResource SceneToggleButtonTheme}"
                          Padding="8,4"
                          Foreground="Black"
                          HorizontalAlignment="Left"
                          Width="120"
                          Height="25">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="  Select  " 
                               VerticalAlignment="Center" />
                    <Path x:Name="ExpandArrow_1"
                          Data="M 0,0 L 4,4 L 0,8"
                          Stroke="#FF000000" StrokeThickness="1.5"
                          VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <StackPanel x:Name="ExtraButtonsPanel"
                        Spacing="1"
                        IsVisible="False">
                <ItemsControl x:Name="SetsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="scene:SetButton">
                            <Button Content="{Binding Title}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="LightGray"
                                    Click="OnSetButtonClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,10,20,0" Spacing="4"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top">
            <ToggleButton x:Name="ViewToggle" 
                         Theme="{StaticResource SceneToggleButtonTheme}"
                          Padding="8,4"
                          Foreground="Black"
                          HorizontalAlignment="Left"
                          Width="120"
                          Height="25">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="View" 
                               VerticalAlignment="Center" />
                    <Path x:Name="ExpandArrow_2"
                          Data="M 0,0 L 4,4 L 0,8"
                          Stroke="#FF000000" StrokeThickness="1.5"
                          VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <Canvas x:Name="ViewButtonsPanel"
                        IsVisible="False">
                <Button Name="btnXY" Background="WhiteSmoke" 
                        Canvas.Right="10" 
                        Canvas.Top="40"
                        Click="OnViewChangeClick">
                    <Image Source="{StaticResource XY}"/>
                </Button>
                <Button Name="btnZX" 
                        Background="WhiteSmoke" 
                        Canvas.Right="10" 
                        Canvas.Top="80"
                        Click="OnViewChangeClick">
                    <Image Source="{StaticResource ZX}"/>
                </Button>
                <Button Name="btnZY" 
                        Background="WhiteSmoke" 
                        Canvas.Right="10"
                        Canvas.Top="120"
                        Click="OnViewChangeClick">
                    <Image Source="{StaticResource ZY}"/>
                </Button>
                <ToggleButton Name="btnRotX" 
                              Classes="OutlineButton"
                              Background="WhiteSmoke"
                              Canvas.Right="10"
                              Canvas.Top="160"
                              Click = "OnRotateChangeModeClick">
                    <Image Source="{StaticResource rotX}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotY" 
                              Classes="OutlineButton"
                              Background="WhiteSmoke"
                              Canvas.Right="10"
                              Canvas.Top="200"
                              Click = "OnRotateChangeModeClick">
                    <Image Source="{StaticResource rotY}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotZ" 
                              Classes="OutlineButton"
                              Background="WhiteSmoke"
                              Canvas.Right="10"
                              Canvas.Top="240"
                              Click = "OnRotateChangeModeClick">
                    <Image Source="{StaticResource rotZ}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotHor" 
                              Classes="OutlineButton"
                              Background="WhiteSmoke"
                              Canvas.Right="10"
                              Canvas.Top="280"
                              Click = "OnRotateByRightAngle">
                    <Image Source="{StaticResource rotHor}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotVer" 
                              Classes="OutlineButton"
                              Background="WhiteSmoke"
                              Canvas.Right="10"
                              Canvas.Top="320"
                              Click = "OnRotateByRightAngle">
                    <Image Source="{StaticResource rotVer}"/>
                </ToggleButton>
            </Canvas>
        </StackPanel>
    </Panel>
</UserControl>
