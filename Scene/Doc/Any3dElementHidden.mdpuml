@startuml

!pragma useVerticalIf on
start
group Алгоритм построения BoundingBox независимых 3д элементов 
:Выделение VBO(левая верхняя точка) равное количеству точек;
:Выделение VBO(правая нижняя точка) равное количеству точек;
:Переменные min_x, max_x, min_y, max_y, min_z, max_z;
:Сброс макимальных и минимальных координат;

while (Рассмотрели все точки?) is (Нет)
  :Текущий элемент = points[i * 4 + 3]; 
  note right: Используем 4 координату установленную в презенаторе!
  if(Предыдущий элемент равен текущему?) then(Нет)
    :Записать в буффер левой верхней точки крайние левые верхние координаты;
    :Записать в буффер правой нижней точки крайние правые нижние координаты;
    :Сброс макимальных и минимальных координат;
  else (Да)
  endif
  :min_x = Math.Min(min_x, points[i * 4 + 0]);
  :max_x = Math.Max(max_x, points[i * 4 + 1]);
  :min_y = Math.Min(min_y, points[i * 4 + 2]);
  :max_y = Math.Max(max_y, points[i * 4 + 0]);
  :min_z = Math.Min(min_z, points[i * 4 + 1]);
  :max_z = Math.Max(max_z, points[i * 4 + 2]);
  :Предыдущий элемент = текущий элемент;
  backward : i++;
endwhile (Да)


:glBufferData для буффера левой верхней точки 
для независимых 3д элементов;
:glBufferData для буффера правой нижней точки 
для независимых 3д элементов;
end group
:передача в шейдер для расчета сокрытия;
stop
@enduml