<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

  <!-- ... set text scalability ... -->

  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="SceneInterface" publicKeyToken="ecbecc097c57e11f" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.0.40.0" newVersion="1.0.40.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Model" publicKeyToken="fb50939feb9441b1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.9.36" newVersion="3.0.9.36" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="ModelInterfaces" publicKeyToken="998e39182864f357" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.24" newVersion="3.0.0.24" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Geometry" publicKeyToken="d064922373770c4c" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.7.31" newVersion="2.0.7.31" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>